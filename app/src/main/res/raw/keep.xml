<?xml version="1.0" encoding="utf-8"?>
<!--
  default_web_client_id is generated by the google-services plugin once Google sign-in is enabled,
  and the app looks it up by name (the build must compile before it exists). Keep it through
  resource shrinking.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
